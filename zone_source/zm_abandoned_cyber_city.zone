>class,zm_mod_level
>group,modtools

// =============================================================================
// zm_abandoned_cyber_city.zone - asset manifest for the Launcher linker.
//
// Format proven against the stock Launcher zm template and shipped community
// maps (e.g. zm_alien_isolation). Notes:
//   - custom scripts use `scriptparsetree`, NOT `rawfile`
//   - stock zombies framework scripts referenced via #using do NOT need
//     entries here - they live in the base game zones
//   - stock weapons come in via the zm_levelcommon_weapons.csv stringtable;
//     individual stock guns need no lines here. The curated v1.0 arsenal
//     (wallbuy/box pools) is select-listed in script - see docs/05_weapons.md.
//   - comments use //, not #
// =============================================================================

xmodel,skybox_default_night
material,luts_t7_default

// NOTE: stock t7_* wall/floor materials are painted on faces in the .map, but they
// are NOT listed here yet. Listing them makes the linker try to COMPILE their
// techset shaders, which FAILS on this install ("failed to open source file:
// techsetdef_buildshadowmap.hlsl" + "material type '' (0)" + gdtdb shows 0 GDTs).
// Until the material/shader-compile pipeline is fixed (docs/29 §14), the surfaces
// render as the missing-material checker. The night sky / fog / probes / rooms work.

// BSP (compiled from map_source/zm/zm_abandoned_cyber_city.map)
col_map,maps/zm/zm_abandoned_cyber_city.d3dbsp
gfx_map,maps/zm/zm_abandoned_cyber_city.d3dbsp

// Audio (sound/zoneconfig/zm_abandoned_cyber_city.szc)
sound,zm_abandoned_cyber_city

// Entry scripts (server + client)
scriptparsetree,scripts/zm/zm_abandoned_cyber_city.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city.csc

// Custom _acc_ modules (server-side; .csc client modules arrive in Phase 4)
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_main.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_early_round_pacing.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_utility.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_data_shards.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_cyberware.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_overclocks.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_elites.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_map_randomizer.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_events_hack.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_events_overload.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_emergency_drop.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_modifiers.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_boss.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_boss_brutus.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_boss_items.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_mega_bottles.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_weapon_variants.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_perks.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_weapon_abilities.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_points.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_damage.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_perk_aura_blast.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_decontamination.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_coop_scaling.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_rampage_inducer.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_dev.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_perk_info.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_ui.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_health_bars.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_pap_levels.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_atmosphere.gsc

// NSZ Brutus boss pack (custom aitype zm_brutus + BO2 model + custom anims).
// Assets imported via APE from model_export/_NSZ/_GDT/_NSZ_Brutus.gdt at the Mod
// Tools root; the script is vendored under scripts/_NSZ. Full audit:
// docs/research/NateSmithZombies_Brutus_BO2_boss_pack.txt
scriptparsetree,scripts/_NSZ/nsz_brutus.gsc
scriptbundle,brutus_bundle
xmodel,brutus_helmet
xmodel,bo2_brutus_fb_death
xmodel,perk_clip
fx,_NSZ/Brutus/spawn_fx
fx,_NSZ/Brutus/chest_fx
fx,_NSZ/Brutus/helmet_smoke
fx,fire/fx_fire_ground_rubble_50x50

// LUI client pipeline foundation (server module + client mirror + Lua overlay).
// docs/28_lui_pipeline.md. The .lua is a rawfile (copied verbatim, parsed by the
// game's Lua VM at runtime - a Lua syntax error shows at load, NOT at link).
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_lui.gsc
scriptparsetree,scripts/zm/zm_abandoned_cyber_city/_acc_lui.csc
rawfile,ui/uieditor/menus/hud/acc_hud.lua

// Makes the linker read the weapons table (box needs this). The usermap copy
// at gamedata/weapons/zm/ (deployed by sync) overrides the stock table: it is
// the stock 50-weapon table + the 3 Skye box imports below.
stringtable,gamedata/weapons/zm/zm_levelcommon_weapons.csv

// Box guns (user, 2026-06-14): 6 - Tac-19, Five-Seven, ASM1, AK-47, AE4, Ripper
// (all Skye imports; see docs/32 + docs/33). One pair per gun (base + PaP), except
// the Ripper = 4 convertible assets (smg/ar x base/_up). GDT converted by gdtdb.
weapon,s1_tac19
weapon,s1_tac19_up

// Five-Seven (BO2 t6_fiveseven) = the STARTING pistol (level.start_weapon, set
// in _acc_main::init). Dual-wield variants included (PaP akimbo). ASM1 = AW SMG (box).
weapon,t6_fiveseven
weapon,t6_fiveseven_up
weapon,t6_fiveseven_rdw_zm
weapon,t6_fiveseven_ldw_zm
weapon,t6_fiveseven_rdw_up_zm
weapon,t6_fiveseven_ldw_up_zm
weapon,s1_asm1
weapon,s1_asm1_up

// AK-47 (BO2 t6_ak47) = full-auto AR box gun (user, 2026-06-14). See docs/33.
weapon,t6_ak47
weapon,t6_ak47_up

// AE4 (AW s1_ae4) = directed-energy AR box gun (user, 2026-06-14). See docs/33.
weapon,s1_ae4
weapon,s1_ae4_up

// Ripper (Ghosts iw6_ripper) = convertible SMG<->AR box gun (user, 2026-06-14).
// 4 assets (smg/ar x base/_up) linked by altWeapon; box gives the SMG-mode
// primary (CSV name iw6_ripper_smg, no _zm - per the pack's ADD-TO files). NO perk
// twins (convertible altWeapon conflicts with the twin-swap engine). See docs/33.
weapon,iw6_ripper_smg_zm
weapon,iw6_ripper_ar_zm
weapon,iw6_ripper_smg_up_zm
weapon,iw6_ripper_ar_up_zm

// Perk weapon-variant TWIN matrix (110 = 11 combos x 5 guns x base/_up): recoil
// (Deadshot -35%/-70%) x fastfire (Gun Slinger) x fastreload (Speed Cola Mega). GDT =
// source_data/acc_weapon_variants.gdt, generated by tools/apply_recoil_overhaul.js
// (also runs gdtdb /update). Must stay in sync with build_available_twins(). Consumed
// by _acc_weapon_variants.gsc (axis model); default ON. Add an effect: docs/30.
weaponfull,s1_asm1_acc_fastfire
weaponfull,s1_asm1_acc_fastfire_fastreload
weaponfull,s1_asm1_acc_fastreload
weaponfull,s1_asm1_acc_recoil35
