>class,zm_mod_level
>group,modtools

// =============================================================================
// zm_abandoned_cyber_city.zone - asset manifest for the Launcher linker.
//
// Format proven against the stock Launcher zm template and shipped community
// maps (e.g. zm_alien_isolation). Notes:
//   - custom scripts use `scriptparsetree`, NOT `rawfile`
//   - stock zombies framework scripts referenced via #using do NOT need
//     entries here - they live in the base game zones
//   - stock weapons come in via the zm_levelcommon_weapons.csv stringtable;
//     individual stock guns need no lines here. The curated v1.0 arsenal
//     (wallbuy/box pools) is select-listed in script - see docs/05_weapons.md.
//   - comments use //, not #
// =============================================================================

xmodel,skybox_default_night
// Electric Cherry machine (West Community Perk Collection v2.7, external pack - see
// tools/external_assets_manifest.ps1). Runtime-SetModel by perk_machine_think, so it
// needs this explicit line (docs/44). Replaced the p7_lab_bio_machinery_01 stand-in 2026-07-01.
xmodel,electric_cherry_model
material,luts_t7_default

// Map-name vision grade = NEUTRAL stock default (NOT a custom tint). MUST stay neutral:
// the engine treats the MAP-NAME vision as each client's "default" visionset and
// FORCE-RESTORES it per-client on every revive (visionset_mgr / _zm_laststand), which
// BYPASSES our server-side change-gated VisionSetNaked("default") — so a tinted file here
// shows up as a stuck grade ONLY after a down/revive (the 2026-06-24 "gray screen on
// revive" bug). Ship base colours = grade OFF (ACC_VISION_ON 0); this file == stock
// default.vision. _acc_atmosphere::apply_vision still drives the GLOBAL slot. docs/29 §7b.
// Source: vision/zm_abandoned_cyber_city.vision (synced by tools/sync_to_modtools.ps1).
rawfile,vision/zm_abandoned_cyber_city.vision

// Live-swappable alternate grades for in-game A/B (no rebuild to choose): set
// acc_vision_set acc_grade_magenta | acc_grade_orange | acc_grade_dark (hotter-magenta,
// orange-neon, darker-magenta casts; docs/29 §7b). These are DORMANT — the default ships
// grade-OFF (base colours). LED-free.
rawfile,vision/acc_grade_magenta.vision
rawfile,vision/acc_grade_orange.vision
rawfile,vision/acc_grade_dark.vision
// NEUTRAL near-black crush (vkRM 0.08, R=G=B, no hue) applied per trench depth to defeat the abyss
// IBL/tonemap baseline that point-light dimming can't reach (_acc_atmosphere::apply_vision, 2026-06-22).
rawfile,vision/acc_grade_abyss_dark.vision
// Even darker neutral (~5%) used as the START of the power-on light WARM-UP: applied instantly when power
// comes on, then lerped to "default" over ~10s so the baked lights swell up instead of snapping on (2026-06-22).
rawfile,vision/acc_grade_blackout.vision
// Intermediate neutral brightness stages (~18%, ~45%) for the EXPONENTIAL power-on warm-up: after holding
// blackout super-dark, the ramp accelerates blackout -> warm1 -> warm2 -> default (2026-06-22).
rawfile,vision/acc_grade_warm1.vision
rawfile,vision/acc_grade_warm2.vision

// NOTE: stock t7_* wall/floor materials are painted on faces in the .map, but they
// are NOT listed here yet. Listing them makes the linker try to COMPILE their
// techset shaders, which FAILS on this install ("failed to open source file:
// techsetdef_buildshadowmap.hlsl" + "material type '' (0)" + gdtdb shows 0 GDTs).
// Until the material/shader-compile pipeline is fixed (docs/29 §14), the surfaces
// render as the missing-material checker. The night sky / fog / probes / rooms work.

// BSP (compiled from map_source/zm/zm_abandoned_cyber_city.map)
col_map,maps/zm/zm_abandoned_cyber_city.d3dbsp
gfx_map,maps/zm/zm_abandoned_cyber_city.d3dbsp

// Audio (sound/zoneconfig/zm_abandoned_cyber_city.szc)
sound,zm_abandoned_cyber_city

