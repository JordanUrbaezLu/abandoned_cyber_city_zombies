// Full mechanism trace: the Mahem comment block above.
function make_war_machine_pap_visible_to_tier3()
{
    if ( !isdefined( level.aat_exemptions ) ) return;
    up = GetWeapon( "t6_war_machine_up" );
    if ( !isdefined( up ) || up == level.weaponNone ) return;
    up = zm_weapons::get_nonalternate_weapon( up );

